rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write to their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Rules for the speeches subcollection
      match /speeches/{speechId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Ensure that the user is not trying to delete the entire collection
        allow list: if request.auth != null && request.auth.uid == userId;

        // Validate the data being written to the database
        allow create: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.name is string &&
          request.resource.data.content is string;
      }

      // Rules for the emojiAssociations subcollection
      match /speeches/{speechId}/emojiAssociations/{associationId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Ensure that the user is not trying to delete the entire collection
        allow list: if request.auth != null && request.auth.uid == userId;

        // Validate the data being written to the database
        allow create: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.originalText is string &&
          request.resource.data.emoji is string &&
          request.resource.data.position is number;
      }
    }
  }
}